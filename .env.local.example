# ============================================================
# YouTube AI Channel Manager — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (for login + YouTube API) ---
# Get from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web application)
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- AI Model APIs ---
# Gemini (FREE): https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# Claude (PAID): https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenRouter (FREE models available): https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# --- YouTube Data API ---
# Same Google OAuth client as above, but needs youtube scope
# Enable YouTube Data API v3 in Google Console
YOUTUBE_API_KEY=your-youtube-data-api-key
